# Zalo bot token from Zalo Bot Creator (keep secret)
ZALO_BOT_TOKEN=your-zalo-bot-token
# Shared secret Zalo echoes in X-Bot-Api-Secret-Token (8-256 characters)
ZALO_WEBHOOK_SECRET=change-me-to-a-random-string
# Kanna remote MCP endpoint
KANNA_MCP_URL=https://kanna.example.com/mcp
# The password Kanna was started with
KANNA_PASSWORD=your-kanna-password
# Kanna project id that new chats open in
KANNA_PROJECT_ID=your-kanna-project-id
# Comma-separated Zalo user ids allowed to talk to the agent (required, must not be empty)
ZALO_ALLOWED_USER_IDS=your-zalo-user-id

# Optional
PORT=3000
WEBHOOK_PATH=/zalo/webhook
STATE_FILE=./data/state.json
KANNA_TURN_DEADLINE_SECONDS=1800
