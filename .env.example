# Zalo bot token from Zalo Bot Creator (keep secret)
ZALO_BOT_TOKEN=your-zalo-bot-token
# Shared secret Zalo echoes in X-Bot-Api-Secret-Token (8-256 characters)
ZALO_WEBHOOK_SECRET=change-me-to-a-random-string
# Kanna remote MCP endpoint
KANNA_MCP_URL=https://kanna.example.com/mcp
# The password Kanna was started with
KANNA_PASSWORD=your-kanna-password
# Comma-separated Zalo user ids with full control (required, must not be empty)
ZALO_SUPERADMIN_IDS=your-zalo-user-id
# Directory superadmins start in; Kanna opens it as a project (absolute path or ~/...)
KANNA_DEFAULT_DIR=/path/to/your/default/directory

# Optional
# When set, /assign only accepts directories at or below this path (absolute or ~/...)
# ZALO_USER_DIR_ROOT=~/Kanna/users
PORT=3000
WEBHOOK_PATH=/zalo/webhook
STATE_FILE=./data/state.json
KANNA_TURN_DEADLINE_SECONDS=1800
# Language of the bridge's own messages: en or vi
BRIDGE_LANGUAGE=en
# Progress feedback while Kanna works
PROGRESS_ACK=true
PROGRESS_POLL_SECONDS=15
PROGRESS_UPDATE_SECONDS=60
PROGRESS_TYPING_SECONDS=5
# Start a new Kanna conversation after this many idle minutes (0 disables)
SESSION_IDLE_MINUTES=30
